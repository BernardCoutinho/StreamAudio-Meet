{
  "manifest_version": 3,
  "name": "StreamAudio - Áudio por Janela",
  "version": "0.1.4",
  "description": "Captura áudio da janela compartilhada no Meet com ganho ajustável de 0% a 1000%.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Ajustar ganho do StreamAudio",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
